---
import { site, about } from '../../data';
import AssetImage from '../ui/AssetImage.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
const github = site.socials.find(social => social.name === 'GitHub');
---
<section class="section about-section section--bordered" id="about" aria-labelledby="about-heading">
  <div class="container section-stack">
    <SectionHeading id="about-heading" muted="أبني منتجات" title="تحل مشكلات حقيقية." centered />
    <div class="about-grid">
      <div class="about-copy">
        {about.paragraphs.map(paragraph => <p data-reveal>{paragraph}</p>)}
        <div class="tool-orbit" aria-hidden="true">
          <div class="tool-orbit__ring tool-orbit__ring--outer">
          </div>
          <div class="tool-orbit__ring tool-orbit__ring--inner">
          </div>
          <span class="tool-orbit__center">{site.name}</span>
          {about.orbitIcons.map((src, index) => <span class={`tool-orbit__app tool-orbit__app--${index + 1}`}>
          <img src={src} width="40" height="40" alt="" loading="lazy" />
        </span>)}
      </div>
    </div>
    <aside class="about-sidebar">
      <figure class="profile-card" data-reveal>
        <div class="profile-card__image">
          <AssetImage image={site.avatar} sizes="(max-width: 809px) calc(100vw - 44px), 372px" />
          {github && <a class="profile-card__follow" href={github.url} target="_blank" rel="noopener noreferrer" aria-label="GitHub (نافذة جديدة)">
            <Icon name="github" size={15} />
            <span>GitHub</span>
          </a>}
        </div>
        <figcaption>
          <h3>{site.name}</h3>
          <p>{site.aboutRole}</p>
        </figcaption>
      </figure>
      <div class="experience">
        <h3>المسار الذي سلكته</h3>
        <ol>{about.experience.map(job => <li class="experience-card" data-reveal>
        <span>{job.period}</span>
        <h4>{job.company}</h4>
        <p>{job.role}</p>
      </li>)}</ol>
      <a class="text-link" href={site.socials.find(social => social.name === 'LinkedIn')?.url ?? site.socials[0].url} target="_blank" rel="noopener noreferrer">إظهار الكل<Icon name="arrow-up-left" size={15} />
      <span class="sr-only"> (LinkedIn، نافذة جديدة)</span>
    </a>
  </div>
</aside>
</div>
</div>
</section>
