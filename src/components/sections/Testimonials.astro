---
import { testimonials } from '../../data';
import SectionHeading from '../ui/SectionHeading.astro';
import SocialProof from '../ui/SocialProof.astro';
import TestimonialCard from '../cards/TestimonialCard.astro';
---
<section class="section testimonials-section" id="testimonials" aria-labelledby="testimonials-heading">
  <div class="container section-stack">
    <div class="testimonials-heading">
      <SectionHeading id="testimonials-heading" muted="كلمات صادقة" title="من عملائي" />
      <SocialProof />
    </div>
    <div class="testimonials-grid" role="region" aria-label="آراء العملاء، مرّر أفقيًا على الهاتف" tabindex="0">{testimonials.map(testimonial => <TestimonialCard testimonial={testimonial} />)}</div>
  </div>
</section>
