---
import type { Certificate } from '../../types/content';
interface Props { certificate: Certificate; index: number }
const { certificate, index } = Astro.props;
---
<a class={`certificate-card certificate-card--${index + 1}`} href={certificate.url} target="_blank" rel="noopener noreferrer" data-reveal aria-label={`${certificate.title} — ${certificate.issuer} (نافذة جديدة)`}>
  <span class="certificate-card__date">{certificate.date}</span>
  <span dir="auto">{certificate.issuer}</span>
  <h3>{certificate.title}</h3>
</a>
