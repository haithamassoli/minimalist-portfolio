---
import { site } from '../../data';
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT?.trim() || '';
---
<div class="contact-panel" id="contact-form">
  <h3>خلينــا نتواصــل</h3>
  <form class="contact-form" data-contact-form data-endpoint={endpoint} data-recipient={site.email}>
    <label class="sr-only" for="contact-name">الاسم</label>
    <input id="contact-name" name="name" type="text" placeholder="اكتب اسمك" autocomplete="name" required minlength="2" maxlength="100" />
    <label class="sr-only" for="contact-email">البريد الإلكتروني</label>
    <input id="contact-email" name="email" type="email" placeholder="اكتب بريدك الإلكتروني" autocomplete="email" required maxlength="254" />
    <label class="sr-only" for="contact-message">الرسالة</label>
    <textarea id="contact-message" name="message" placeholder="كيف أقدر أساعدك؟" required minlength="10" maxlength="5000" rows="4">
    </textarea>
    <div class="contact-form__trap" aria-hidden="true">
      <label for="contact-website">Leave this field empty</label>
      <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <button class="button button--secondary contact-form__submit" type="submit">أرسل رسالة</button>
    <p class="contact-form__note" id="contact-help">{endpoint ? 'لن تتم مشاركة معلوماتك خارج معالجة رسالتك.' : 'يفتح تطبيق البريد لإنشاء مسودة؛ لا تُرسل الرسالة تلقائيًا.'}</p>
    <p class="contact-form__status" data-form-status role="status" aria-live="polite" tabindex="-1">
    </p>
    <noscript>
      <p>للتواصل مباشرةً: <a href={`mailto:${site.email}`}>{site.email}</a>. يحتاج هذا النموذج إلى JavaScript.</p>
    </noscript>
  </form>
</div>
