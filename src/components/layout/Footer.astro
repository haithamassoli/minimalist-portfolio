---
import { site } from '../../data';
import Icon from '../ui/Icon.astro';
import CallToAction from '../ui/CallToAction.astro';
import ContactForm from './ContactForm.astro';
const year = new Intl.NumberFormat('ar', { useGrouping: false }).format(new Date().getFullYear());
---
<footer class="site-footer" id="footer">
  <div class="container footer-stack">
    <CallToAction footer />
    <div class="footer-grid">
      <ContactForm />
      <div class="footer-info">
        <nav aria-label="روابط التذييل">{site.navigation.map(link => <a href={link.href}>{link.label}</a>)}</nav>
        <div class="footer-info__contact">
          <div class="social-links">{site.socials.map(social => <a href={social.url} target="_blank" rel="noopener noreferrer" aria-label={`${social.name} (نافذة جديدة)`}>
          <Icon name={social.name === 'GitHub' ? 'github' : social.icon} size={24} />
        </a>)}</div>
        <a class="email-pill" href={`mailto:${site.email}`} dir="ltr">{site.email}</a>
        <button class="copy-email" type="button" data-copy-email={site.email}>
          <Icon name="copy" size={15} />
          <span>نسخ البريد الإلكتروني</span>
        </button>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <p>© كل الحقوق محفوظة {year}، {site.fullName} — {site.location}
  </p>
  <a href="#top" class="back-to-top">العودة للأعلى<Icon name="arrow-up" size={18} />
</a>
</div>
</div>
</footer>
