---
import SiteLayout from '../layouts/SiteLayout.astro';
import { site } from '../data';
import Button from '../components/ui/Button.astro';
---
<SiteLayout title={`الصفحة غير موجودة | ${site.name}`}>
  <section class="section not-found container">
    <p class="text-muted" dir="ltr">404</p>
    <h1>الصفحة غير موجودة.</h1>
    <Button href="/" label="العودة للرئيسية" variant="secondary" icon="arrow-left" />
  </section>
</SiteLayout>
