---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { projects } from '../../data';
import ProjectCard from '../../components/cards/ProjectCard.astro';
---
<SiteLayout title="المشاريع | رِزق">
  <section class="section listing-page" aria-labelledby="listing-heading">
    <div class="container section-stack">
      <div class="listing-heading">
        <a class="text-link" href="/">الرئيسية</a>
        <h1 id="listing-heading">المشاريع</h1>
      </div>
      <div class="projects-grid">{projects.map(project => <ProjectCard project={project} />)}</div>
    </div>
  </section>
</SiteLayout>
