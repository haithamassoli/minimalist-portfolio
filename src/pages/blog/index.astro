---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { posts } from '../../data';
import ArticleCard from '../../components/cards/ArticleCard.astro';
---
<SiteLayout title="المدونة | هيثم العسولي">
  <section class="section listing-page" aria-labelledby="listing-heading">
    <div class="container section-stack">
      <div class="listing-heading">
        <a class="text-link" href="/">الرئيسية</a>
        <h1 id="listing-heading">من المدوّنة،<br />
        <span class="text-muted">ملاحظات هندسية.</span>
      </h1>
    </div>
    <div class="articles-grid">{posts.map((post, index) => <ArticleCard post={post} featured={index === 0} />)}</div>
  </div>
</section>
</SiteLayout>
