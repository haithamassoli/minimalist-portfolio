# Public values are visible to website visitors. Never put secrets here.
PUBLIC_SITE_URL=https://example.com
# A server you control: HTTPS URL or same-origin /api/contact.
# Receives JSON: { name, email, message, website }. Returns { "ok": true }.
# Leave empty to open an email draft instead of submitting to a backend.
PUBLIC_CONTACT_ENDPOINT=
# Keep the reference portfolio out of search engines until you replace the identity/content.
PUBLIC_INDEXABLE=false
